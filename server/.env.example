# =============================================================================
# Menia.io API server — environment variables
# =============================================================================
# Copia in `.env` (lo stesso path di index.js) e riempi i valori reali.
# Tutte le chiavi marcate [CRITICA] devono essere settate in produzione.

# ---------- App / hosting ----------
PORT=3001
FRONTEND_URL=https://menia.io
ADMIN_URL=https://admin.menia.io
NODE_ENV=production

# ---------- Supabase ----------               [CRITICA]
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ---------- Admin / dev safety ----------    [CRITICA]
# Token per gli endpoint admin protetti.
ADMIN_SECRET=change-me

# ---------- Stripe (subscription billing) ----------   [CRITICA]
# sk_live_... in produzione, sk_test_... in staging.
# Non committare mai il valore reale.
STRIPE_SECRET_KEY=sk_test_xxx
# Default Price ID per la sottoscrizione studente €0,99/mese.
STRIPE_PRICE_ID=price_xxx
# Webhook signing secret per verificare i payload Stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Pre-launch flag ----------
# Quando true blocca i pagamenti reali e il webhook Stripe (modalità mock).
# In produzione DEVE essere false.
PRE_LAUNCH_MODE=false

# ---------- Email transactional ---------- [CRITICA in prod]
# Provider preferito: "smtp2go" (default) o "resend".
# Il sistema fallback all'altro se il primo non è configurato.
EMAIL_PROVIDER=smtp2go
EMAIL_FROM="Menia.io <noreply@menia.io>"

# --- SMTP2GO ---
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USER=menia.io
SMTP_PASS=

# --- Resend (fallback) ---
RESEND_API_KEY=

# ---------- Sentry monitoring ---------- [opzionale]
SENTRY_DSN=

# ---------- Jitsi (live conferencing) ---------- [feature attualmente disabilitata]
# Se la feature live verrà riattivata, popolare con i secret di prosody/jitsi.
JITSI_APP_ID=menia
JITSI_APP_SECRET=

# ---------- Legacy CCBILL (deprecato) ----------
# Rimuovere quando gli endpoint /checkout/start e /webhooks/ccbill saranno cancellati.
# CCBILL_ACCOUNT=
# CCBILL_SUBACCOUNT=
# CCBILL_FLEX_ID=
# CCBILL_SALT=
