{
  "name": "TokenTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "wallet_type": {
      "type": "string",
      "enum": [
        "user",
        "creator"
      ],
      "default": "user"
    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "spend",
        "earn",
        "refund",
        "payout"
      ]
    },
    "amount": {
      "type": "number",
      "description": "Positive = credit, negative = debit"
    },
    "balance_after": {
      "type": "number"
    },
    "reference_id": {
      "type": "string",
      "description": "Stripe session, content ID, chat ID, etc."
    },
    "description": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "amount",
    "balance_after"
  ]
}