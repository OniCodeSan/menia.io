{
  "name": "PayoutRequest",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "token_amount": {
      "type": "number"
    },
    "euro_amount": {
      "type": "number",
      "description": "token_amount * 0.075"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    }
  },
  "required": [
    "creator_id",
    "token_amount",
    "euro_amount",
    "status"
  ]
}