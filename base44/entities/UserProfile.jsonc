{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "segment": {
      "type": "string",
      "enum": [
        "lurker",
        "spender",
        "whale"
      ],
      "default": "lurker"
    },
    "declared_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags selezionati dall'utente"
    },
    "implicit_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag inferiti dal comportamento"
    },
    "avg_spend_per_session": {
      "type": "number",
      "default": 0
    },
    "total_spent_tokens": {
      "type": "number",
      "default": 0
    },
    "top_creator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_hours": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Ore del giorno con pi\u00f9 attivit\u00e0 (0-23)"
    },
    "preferred_type": {
      "type": "string",
      "enum": [
        "chat",
        "content",
        "live",
        "mixed"
      ],
      "default": "mixed"
    }
  },
  "required": [
    "user_id"
  ]
}