{
  "name": "ContentBehavior",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "view_time_seconds": {
      "type": "number",
      "default": 0
    },
    "scroll_depth": {
      "type": "number",
      "default": 0,
      "description": "0-100%"
    },
    "profile_clicks": {
      "type": "number",
      "default": 0
    },
    "return_visits": {
      "type": "number",
      "default": 0
    },
    "tokens_spent": {
      "type": "number",
      "default": 0
    },
    "converted": {
      "type": "boolean",
      "default": false
    },
    "session_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "creator_id"
  ]
}