{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "creator",
        "fan"
      ],
      "default": "user"
    },
    "handle": {
      "type": "string",
      "description": "Unique @ username for the creator"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "monthly_price": {
      "type": "number"
    },
    "yearly_price": {
      "type": "number"
    },
    "onboarding_complete": {
      "type": "boolean"
    }
  }
}