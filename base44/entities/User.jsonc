{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "creator",
        "fan"
      ],
      "default": "fan",
      "description": "User role: admin, creator, or fan"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "annual"
      ],
      "default": "none"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    }
  }
}