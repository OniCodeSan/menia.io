# =============================================================================
# Menia.io frontend — environment variables (Vite)
# =============================================================================
# Copia in `.env.local` (ignorato da git) e compila con i valori reali.
# Le chiavi [CRITICA] sono richieste — il sito non monta senza Supabase.

# ---------- Supabase ---------- [CRITICA]
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Stripe (client-side) ---------- [opzionale per dev]
# Publishable key (pk_test_... o pk_live_...). Non strettamente richiesta:
# il flow di checkout è server-side con redirect. Lasciala vuota se non usi
# Stripe Elements lato client.
VITE_STRIPE_PUBLIC_KEY=

# ---------- Pre-launch flag ----------
# Se "true" disabilita i pagamenti reali — utile in dev locale.
# In produzione lascia "false".
VITE_PRE_LAUNCH_MODE=false

# ---------- Sentry (frontend) ---------- [opzionale]
VITE_SENTRY_DSN=
